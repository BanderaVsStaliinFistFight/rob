{
  "name": "ImperialShip",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "ImperialShip": {
        "$path": "dist/ImperialShip.rbxm"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 0,
        "Brightness": 0.4,
        "Ambient": [
          0.085,
          0.078,
          0.07
        ],
        "OutdoorAmbient": [
          0.04,
          0.04,
          0.05
        ],
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 1,
        "ExposureCompensation": 0.3,
        "GlobalShadows": true,
        "ShadowSoftness": 0.15
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "CelestialBodiesShown": false
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.4,
          "Size": 24,
          "Threshold": 1.8
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.16,
          "Saturation": -0.12,
          "Brightness": -0.01,
          "TintColor": [
            1.0,
            0.95,
            0.9
          ]
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 40
      }
    }
  }
}
